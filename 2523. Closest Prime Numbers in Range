class Solution {
    public int[] closestPrimes(int left, int right) {
        int ans[] = {-1, -1};
        int prev= -1;
        int min = Integer.MAX_VALUE;
        for(int i = left; i <= right; i++) {
            boolean prime = true;
            if(i <2) 
            prime = false;
            for(int j = 2; j * j <= i; j++) {
                if(i % j == 0) {
                    prime = false;
                    break;
                }
            }
            if(prime) {
            if(prev != -1 && i - prev < min) {
                min = i - prev;
                ans[0] = prev;
                ans[1] = i;
            }
            prev = i;
        }
    }
    return ans;
    }
}
